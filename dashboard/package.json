{
  "name": "mednow-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "MedNow Praxis-Dashboard: Slots und Wochenvorlagen pflegen, Buchungen sehen.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run --configLoader runner",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
