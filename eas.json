{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "memory",
        "EXPO_PUBLIC_DIAGNOSTICS": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_DATA_MODE": "memory",
        "EXPO_PUBLIC_DIAGNOSTICS": "1"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "preview-backend": {
      "extends": "preview",
      "channel": "preview-backend",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_DATA_MODE": "supabase",
        "EXPO_PUBLIC_DIAGNOSTICS": "1",
        "EXPO_PUBLIC_SUPABASE_URL": "https://gimynoopnheaapqihsdb.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_VX11VqjLcbwXMY4K0uh7Dw_Vz5165x9"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "supabase",
        "EXPO_PUBLIC_SUPABASE_URL": "https://gimynoopnheaapqihsdb.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_VX11VqjLcbwXMY4K0uh7Dw_Vz5165x9"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
