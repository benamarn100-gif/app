# Kopiere nach .env.local und trage Werte ein. Niemals den Service-Role-Key hier eintragen.
# Datenmodus: "memory" (Demo ohne Backend) oder "supabase"
EXPO_PUBLIC_DATA_MODE=memory
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Demo-Stadt: fulda | kassel | wuerzburg
EXPO_PUBLIC_DEMO_CITY=fulda
# MapLibre-Stil (Entwicklung: OpenFreeMap). Produktion: eigener EU-Tileserver.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Fehler-Monitoring (optional, nur EU-DSN, z. B. https://<key>@o<org>.ingest.de.sentry.io/<id>)
EXPO_PUBLIC_SENTRY_DSN=
# Testversion: Diagnose-Seite (Profil) und Startzeit-Messung. In EAS-Profilen preview/development gesetzt.
EXPO_PUBLIC_DIAGNOSTICS=
